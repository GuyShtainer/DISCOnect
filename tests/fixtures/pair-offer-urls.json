    "http://[fe80::1]:1",
    "http://[2001:db8:0:0:0:0:0:1]:65535",
    "http://[2001:db8::]:80",
    "http://[::]:80",
    "http://mymac.local:8321",
    "http://a:80",
    "http://x-1.y2.example:9",
    "http://host123:65535"
  ],
